{
  "rules": {
    ".read": false,
    ".write": false,
    "clinic": {
      "roles": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('clinic/roles').child(auth.uid).child('admin').val() === true)",
          ".write": false
        }
      },
      "publicData": {
        ".read": true,
        ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true"
      },
      "adminWorkspace": {
        ".read": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true"
      },
      "appointmentQueue": {
        ".read": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        "$reference": {
          ".read": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || data.child('uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'Requested') || (data.exists() && data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'Cancellation Requested' && newData.child('reference').val() === data.child('reference').val() && newData.child('date').val() === data.child('date').val() && newData.child('time').val() === data.child('time').val() && newData.child('serviceId').val() === data.child('serviceId').val() && newData.child('name').val() === data.child('name').val() && newData.child('phone').val() === data.child('phone').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
          ".validate": "newData.hasChildren(['reference','uid','status','serviceId','date','time','name','phone','createdAt'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "reference": {
            ".validate": "newData.isString() && newData.val() === $reference && newData.val().length <= 100"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "serviceId": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "serviceName": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "dentistId": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "dentistName": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^(19|20|21)[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 30"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "createdAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "userAppointments": {
        ".read": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('clinic/roles').child(auth.uid).child('admin').val() === true)",
          ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
          "$reference": {
            ".write": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || (auth.uid === $uid && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'Requested') || (data.exists() && data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'Cancellation Requested' && newData.child('reference').val() === data.child('reference').val() && newData.child('date').val() === data.child('date').val() && newData.child('time').val() === data.child('time').val() && newData.child('serviceId').val() === data.child('serviceId').val() && newData.child('name').val() === data.child('name').val() && newData.child('phone').val() === data.child('phone').val() && newData.child('createdAt').val() === data.child('createdAt').val()))))",
            ".validate": "newData.hasChildren(['reference','uid','status','serviceId','date','time','name','phone','createdAt'])",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "reference": {
              ".validate": "newData.isString() && newData.val() === $reference && newData.val().length <= 100"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "serviceId": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "serviceName": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "dentistId": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "dentistName": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^(19|20|21)[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            },
            "time": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
            },
            "phone": {
              ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 30"
            },
            "email": {
              ".validate": "newData.isString() && newData.val().length <= 150"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 1200"
            },
            "createdAt": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "updatedAt": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "source": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "slotLocks": {
        ".read": true,
        "$date": {
          "$time": {
            ".write": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid','createdAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "createdAt": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "enquiries": {
        ".read": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        ".write": "auth != null && root.child('clinic/roles').child(auth.uid).child('admin').val() === true",
        "$id": {
          ".read": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || data.child('uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('clinic/roles').child(auth.uid).child('admin').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['id','uid','name','message','reason','createdAt','status'])",
          "id": {
            ".validate": "newData.isString() && newData.val() === $id"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
          },
          "method": {
            ".validate": "newData.isString() && (newData.val() === 'Phone' || newData.val() === 'Email')"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1800"
          },
          "reason": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "createdAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "source": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        }
      },
      "users": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('clinic/roles').child(auth.uid).child('admin').val() === true)",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid','name','email','role','createdAt'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "role": {
            ".validate": "newData.val() === 'patient'"
          },
          "createdAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
